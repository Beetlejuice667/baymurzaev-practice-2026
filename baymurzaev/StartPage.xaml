<Page x:Class="baymurzaev.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:baymurzaev"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Главная" Background="#F4F7F9">

    <Grid>
        <Button x:Name="BtnViewRoutes" Click="BtnViewRoutes_Click" 
                Width="450" Height="180" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#1A5276" Foreground="White" BorderThickness="0" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>

            <Button.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" Color="#2C3E50"/>
            </Button.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🚌" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Управление маршрутами" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Перейти к списку и редактированию автобусных линий ГКУ РБ" FontSize="12" Opacity="0.8" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>