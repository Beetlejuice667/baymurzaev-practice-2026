<Page x:Class="baymurzaev.autoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная" Background="#F4F7F9">

    <Grid>
        <Button x:Name="BtnViewRoutes" Click="BtnViewRoutes_Click" 
                Width="400" Height="220" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#1A5276" Foreground="White" BorderThickness="0" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>

            <Button.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.4" Color="#2C3E50"/>
            </Button.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🚌" FontSize="70" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="Управление маршрутами" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Перейти к списку автобусных линий ГКУ РБ" FontSize="12" Opacity="0.8" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>