<Window x:Class="baymurzaev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ГКУ РБ «Центр организации перевозок»" Height="700" Width="1100" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#DCDDE1" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ГКУ РБ «ЦЕНТР ОРГАНИЗАЦИИ ПЕРЕВОЗОК»" FontSize="22" FontWeight="Bold" Foreground="#1A5276"/>
                    <TextBlock Text="Система управления — ABR Group" FontSize="13" Foreground="#7F8C8D"/>
                </StackPanel>
                <Button x:Name="BtnBack" Content="Назад" Width="120" Height="35" HorizontalAlignment="Right" Click="BtnBack_Click" Visibility="Hidden" Background="#E84118" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" ContentRendered="MainFrame_ContentRendered"/>
    </Grid>
</Window>