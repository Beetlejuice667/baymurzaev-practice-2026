<Page x:Class="baymurzaev.RoutesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Маршруты" Background="#F0F2F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="Поиск маршрута" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="TBoxSearch" Width="300" Height="35" 
                             VerticalContentAlignment="Center" Padding="10,0"
                             TextChanged="TBoxSearch_TextChanged"/>
                </StackPanel>
                <Button Content="+ Новый маршрут" Margin="20,17,0,0" Width="150" Height="35"
                        Background="#1A5276" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LBoxRoutes">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="10" Margin="0,0,0,15" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.1"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Название}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Номер: " Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding Номер_маршрута}" FontWeight="SemiBold" Margin="5,0,20,0"/>
                                        <TextBlock Text="ID: " Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding ID_маршрута}" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Content="Изменить" Width="100" Height="30" Margin="0,0,10,0" Background="#F39C12" Foreground="White" BorderThickness="0"/>
                                    <Button Content="Удалить" Width="100" Height="30" Background="#E74C3C" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="TBlockCount" Grid.Row="2" HorizontalAlignment="Right" 
                   Margin="0,10,0,0" Text="Записей: 0" Foreground="#7F8C8D" FontWeight="Bold"/>
    </Grid>
</Page>